{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensource.lakehouse.dev/schemas/org.schema.json",
  "title": "Lakehouse org identity",
  "type": "object",
  "required": ["orgName", "brand", "packageScope", "domain"],
  "properties": {
    "orgName": {
      "type": "string",
      "minLength": 1,
      "description": "GitHub organization login (mutable on rename)."
    },
    "brand": {
      "type": "string",
      "minLength": 1,
      "description": "Stable public brand name."
    },
    "packageScope": {
      "type": "string",
      "pattern": "^@[a-z0-9][a-z0-9-]*$",
      "description": "Brand-based package scope (not the GitHub org slug)."
    },
    "domain": {
      "type": "string",
      "pattern": "^(?!.*\\.github\\.io$)([a-z0-9]([a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,}$",
      "description": "Custom FQDN for public links/badges; github.io is rejected."
    }
  },
  "additionalProperties": true
}
